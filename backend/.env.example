NODE_ENV=development
PORT=8080
CLIENT_URL=http://localhost:5173

# Must be a direct postgres:// or postgresql:// connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/notes_app

# Generate two different secrets, at least 32 characters each:
#   openssl rand -hex 32
# The server refuses to start if these are missing, too short, or identical.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
